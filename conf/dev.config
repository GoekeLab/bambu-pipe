// Development parameters — not intended for end users
params {
    bambu_path                      = null
    valid_chemistries               = ['10x3v2', '10x3v3', '10x3v4', '10x5v2', '10x5v3', 'visium-v1', 'visium-v2', 'visium-v3']
    valid_technologies              = ['ONT', 'PacBio']
    valid_quantification_modes      = ['no_quant', 'EM', 'clusteredEM']
    save_intermediates              = false
    qfilter_threshold               = 10
    process_by_chromosome           = true
    discovery_ncore                 = 2                 // cap CPUs for transcript discovery to prevent max memory usage
    max_forks_rc                    = 4                 // cap num parallel processes to cap max memory usage
    harmony_seed                    = 42                // random seed for Harmony's initialisation, so multi-sample clusters are reproducible
    cellranger_dir                  = "/opt/spaceranger-4.0.1/lib/python/cellranger/barcodes"
}

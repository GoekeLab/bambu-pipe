process {
    // Retry up to 2 times (3 attempts), doubling memory and extending time with each attempt
    maxRetries = 2
    errorStrategy = { task.exitStatus in [130, 137, 139, 143] ? 'retry' : 'finish' }

    // CPU Labels (fixed across retries: more CPUs do not fix memory or time failures)
    withLabel: 'single_cpu'     { cpus = 1  }
    withLabel: 'low_cpu'        { cpus = 4  }
    withLabel: 'medium_cpu'     { cpus = 16 }
    withLabel: 'high_cpu'       { cpus = 32 }

    // Memory Labels (double each retry)
    withLabel: 'low_mem'        { memory = { 16.GB  * Math.pow(2, task.attempt - 1) } }
    withLabel: 'medium_mem'     { memory = { 64.GB  * Math.pow(2, task.attempt - 1) } }
    withLabel: 'high_mem'       { memory = { 128.GB * Math.pow(2, task.attempt - 1) } }

    // Time Labels (increase with retries)
    withLabel: 'short'          { time = { 1.h  * task.attempt } }
    withLabel: 'medium'         { time = { 4.h  * task.attempt } }
    withLabel: 'long'           { time = { 12.h * task.attempt } }

    // An ordinary R error exits with 1, the same as a BiocParallel worker running out of memory,
    // so exit code 1 is retried once only
    withLabel: 'bambu|seurat'   { errorStrategy = { task.exitStatus in [130, 137, 139, 143] || (task.exitStatus == 1 && task.attempt == 1) ? 'retry' : 'finish' } }
}